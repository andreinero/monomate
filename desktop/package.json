{
  "name": "monomate-desktop",
  "productName": "MonoMate",
  "version": "1.0.0",
  "description": "MonoMate chess for Windows",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.andrej.monomate",
    "productName": "MonoMate",
    "directories": {
      "output": "../dist/windows"
    },
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MonoMate",
      "installerLanguages": [
        "en_US"
      ],
      "multiLanguageInstaller": false,
      "warningsAsErrors": false
    }
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0"
  }
}