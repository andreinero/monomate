{
  "expo": {
    "name": "MonoMate",
    "slug": "monomate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andrej.monomate",
      "appleTeamId": "JWTRPJVHQ2",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3F3F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.andrej.monomate",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-audio",
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MonoMate uses a photo you choose as your profile picture.",
          "cameraPermission": "MonoMate lets you take a photo for your profile picture."
        }
      ]
    ],
    "scheme": [
      "monomate",
      "com.andrej.monomate"
    ],
    "backgroundColor": "#FFFFFF"
  }
}
